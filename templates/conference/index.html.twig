{% extends 'base.html.twig' %}

{% block title %}Hello ConferenceController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		<h1>Hello
			{{ controller_name|capitalize }}! ✅ 👍</h1>

		This friendly message is coming from:
		<ul>
			<li>Your controller at
				<code>/var/www/guestbook/src/Controller/ConferenceController.php</code>
			</li>
			<li>Your template at
				<code>/var/www/guestbook/templates/conference/index.html.twig</code>
			</li>
		</ul>

		<h2>Give your feedback</h2>

		{% for conference in conferences %}

			<ul>
				<li>{{ conference }}</li>
			</ul>

			<p>
				<a href="{{ path('conference', { 'id': conference.id }) }}">View</a>
			</p>

		{% endfor %}

		<html>
			<body>
				<img src="/images/under-construction.gif"/>
			</body>
		</html>

	</div>
{% endblock %}
